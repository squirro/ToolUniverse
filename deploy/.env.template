# SMCP runtime environment.
# Copy to .env on sempart-demo and fill in values. .env is gitignored.
#
# Only set what you actually use — tools that don't see their key will
# return an error at call time, but the server still boots.

# --- LLM providers ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_VERSION=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Azure OpenAI (used by some TU agentic tools)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# OpenRouter (fallback provider)
OPENROUTER_API_KEY=
OPENROUTER_SITE_NAME=
OPENROUTER_SITE_URL=

# --- HuggingFace (model/dataset downloads, embedding cache) ---------
HF_TOKEN=
HF_EMBED_MODEL=

# --- Scientific APIs -------------------------------------------------
FDA_API_KEY=
BIOGRID_API_KEY=
BIOGRID_ACCESS_KEY=

# ICD (WHO API)
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=

# --- TU runtime tuning (optional) ------------------------------------
TOOLUNIVERSE_LOG_LEVEL=INFO
TOOLUNIVERSE_CACHE_ENABLED=true
# TOOLUNIVERSE_CACHE_DIR=/root/.tooluniverse/cache
# TOOLUNIVERSE_CACHE_DEFAULT_TTL=86400
