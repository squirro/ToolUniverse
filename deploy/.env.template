# SMCP runtime environment.
# Copy to .env on sempart-demo and fill in values. .env is gitignored.
#
# Only set what you actually use — tools missing their key error at
# call-time but the server still boots. Categories below are sourced
# from a full grep of os.environ / os.getenv references in TU's source.

# =====================================================================
# LLM providers
# =====================================================================
OPENAI_API_KEY=
OPENAI_API_VERSION=
GEMINI_API_KEY=

# Azure OpenAI (used by some TU agentic tools)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# OpenRouter (fallback provider)
OPENROUTER_API_KEY=
OPENROUTER_SITE_NAME=
OPENROUTER_SITE_URL=

# NVIDIA (BioNeMo / NIM inference endpoints)
NVIDIA_API_KEY=

# vLLM (self-hosted LLM endpoint)
# VLLM_SERVER_URL=

# =====================================================================
# Embeddings (used by the FAISS tool-discovery index)
# =====================================================================
HF_TOKEN=
HF_EMBED_MODEL=
# EMBED_PROVIDER=
# EMBED_MODEL=
# LOCAL_EMBED_MODEL=

# =====================================================================
# Scientific APIs — biomedical
# =====================================================================
NCBI_API_KEY=
# openFDA (FAERS, drug labels)
FDA_API_KEY=
# UMLS Metathesaurus
UMLS_API_KEY=
# Online Mendelian Inheritance in Man
OMIM_API_KEY=
# OncoKB clinical/biological variant info
ONCOKB_API_TOKEN=
# DisGeNET gene-disease associations
DISGENET_API_KEY=
# higher rate limit for Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=
# ESM-fold (protein structure prediction)
ESM_API_KEY=
# Addgene plasmid repository
ADDGENE_API_KEY=

# BioGRID (older `_ACCESS_KEY`, newer `_API_KEY` — set whichever you have)
BIOGRID_API_KEY=
BIOGRID_ACCESS_KEY=

# BRENDA (enzyme DB — uses HTTP basic auth, not a bearer token)
BRENDA_EMAIL=
BRENDA_PASSWORD=

# =====================================================================
# Scientific APIs — chemistry / drug discovery
# =====================================================================
# Broad Institute Connectivity Map
CLUE_API_KEY=
# Mcule virtual chemistry
MCULE_API_KEY=
# USDA FoodData Central (yes, food — used by metabolomics tools)
FDC_API_KEY=

# =====================================================================
# Scientific APIs — patents
# =====================================================================
# European Patent Office Open Patent Services
EPO_OPS_KEY=
EPO_OPS_SECRET=
# United States Patent Office
USPTO_API_KEY=

# =====================================================================
# Health / regulatory
# =====================================================================
# WHO ICD-11 API
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=

# =====================================================================
# TU runtime tuning (all optional — defaults shown commented)
# =====================================================================
TOOLUNIVERSE_LOG_LEVEL=INFO
# TOOLUNIVERSE_CACHE_ENABLED=true
# TOOLUNIVERSE_CACHE_DIR=/root/.tooluniverse/cache
# TOOLUNIVERSE_CACHE_DEFAULT_TTL=86400
# TOOLUNIVERSE_CACHE_MEMORY_SIZE=1000
# TOOLUNIVERSE_CACHE_PERSIST=true
# TOOLUNIVERSE_CACHE_SINGLEFLIGHT=true
# TOOLUNIVERSE_LAZY_LOADING=false
# TOOLUNIVERSE_LIGHT_IMPORT=false
# TOOLUNIVERSE_QUIET=false
# TOOLUNIVERSE_STRICT_VALIDATION=false
# TOOLUNIVERSE_THREAD_POOL_SIZE=10
# TOOLUNIVERSE_LLM_DEFAULT_PROVIDER=openai
# TOOLUNIVERSE_LLM_TEMPERATURE=0.7

# =====================================================================
# Local data paths — set ONLY if you've downloaded the corresponding
# reference dataset into the workspace volume. Leave blank otherwise.
# =====================================================================
# COMPASS_MODEL_PATH=
# DEPMAP_DATA_PATH=
# PINNACLE_DATA_PATH=
# TRANSCRIPTFORMER_DATA_PATH=
# TU_DATA_DIR=
#   LEAVE THIS UNSET for container deployments. The Dockerfile sets it to
#   /home/app/.tooluniverse/cache precisely so the non-root process (uid 10001)
#   can write it -- /root is mode 0700 and unreachable. `--env-file` OVERRIDES
#   the image ENV, so uncommenting this with a /root path silently undoes that
#   hardening and every runtime write fails with EACCES while the server still
#   answers 200. Set it only to a path uid 10001 owns.

# =====================================================================
# Squirro hookups — only set if you want SMCP tools to call back into a
# Squirro project (most SMCP deployments do NOT need these).
# =====================================================================
# SQUIRRO_CLUSTER=
# SQUIRRO_PROJECT=
# SQUIRRO_TOKEN=

# --- Skill Runs on Temporal (ADR-0016) -----------------------------------------
# Leave TEMPORAL_ADDRESS empty and SMCP serves no run_skill and starts no worker.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=skills

# --- Skill Processes in GraphDB (ADR-0016, DSR-709) --------------------------
# run_skill reads the process from here at run start; publish with
# deploy/publish_skill_graphs.py. From inside the container the host's SSH
# tunnel is host.containers.internal (podman) / host.docker.internal (docker).
GRAPHDB_ENDPOINT=http://host.containers.internal:7200
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_SKILLS_REPO=skill-processes
